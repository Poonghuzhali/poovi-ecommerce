# API URL — set to your Render backend URL in production
VITE_API_URL=http://127.0.0.1:8000/api

# Firebase Configuration (create a free project at https://console.firebase.google.com)
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_APP_ID=poovi-ecommerce

# GitHub Pages base path (set to your repo name if deploying to GitHub Pages)
# VITE_BASE_PATH=/ecommerce-app/
